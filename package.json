{
  "name": "ratecoaster",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "node scripts/lint.mjs",
    "android": "npm run -w @ratecoaster/mobile android",
    "mobile": "npm run -w @ratecoaster/mobile start",
    "db:generate": "npm run -w @ratecoaster/db generate",
    "db:migrate": "npm run -w @ratecoaster/db migrate",
    "db:push": "npm run -w @ratecoaster/db push",
    "db:seed": "npm run -w @ratecoaster/db seed",
    "collect": "tsx apps/api/src/jobs/run.ts",
    "collect:prod": "npm run -w @ratecoaster/api collect:prod"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "~19.2.4",
    "@types/react-dom": "~19.2.3",
    "postcss": "8.5.26",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-native": "0.86.3",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-native": "0.86.3",
    "@types/react": "~19.2.4",
    "postcss": "8.5.26",
    "sharp": "0.35.5",
    "source-map-js": "^1.2.2"
  },
  "engines": {
    "node": ">=22"
  }
}
