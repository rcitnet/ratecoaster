# RateCoaster production configuration
#
# Copy to /home/ratecoaster/app/.env on the server, then:
#   chmod 600 /home/ratecoaster/app/.env
#
# Domains are already set to ratecoaster.net. Replace every CHANGE_ME with a
# real value. Both services read this same file.
#
# QUOTE any value containing spaces, (), <>, ; or #. This file is read with
# `set -a && . ./.env`, which parses it as shell — an unquoted < is a redirect
# and the error points at the line without explaining why.

# ─── Basics ──────────────────────────────────────────────────────────────────
NODE_ENV=production
SITE_NAME=RateCoaster

# ─── Database ────────────────────────────────────────────────────────────────
# The password here must match the one you gave the ratecoaster database user.
DATABASE_URL=postgres://ratecoaster:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/ratecoaster

# ─── Addresses ───────────────────────────────────────────────────────────────
# Read this block carefully — mixing these three up is the most common reason a
# deploy "works" but sign-in silently doesn't.

# Where the API listens. Localhost only: the outside world reaches it through
# Caddy at /api, never directly, so it does not need to be exposed.
API_PORT=8787

# How the WEBSITE talks to the API, server to server, inside the machine.
# Internal address, no HTTPS needed, never seen by a browser.
API_BASE_URL=http://127.0.0.1:8787

# The API's PUBLIC address. Used for sign-in links in emails and OAuth
# redirects. Must be reachable from someone's phone, so it is the real domain.
PUBLIC_API_URL=https://ratecoaster.net/api

# What the BROWSER uses to call the API. NEXT_PUBLIC_ variables are baked into
# the JavaScript at build time, so changing this means rebuilding the website.
NEXT_PUBLIC_API_BASE_URL=https://ratecoaster.net/api
NEXT_PUBLIC_SITE_URL=https://www.ratecoaster.net

# Your website's address. Used for redirects after sign-in.
WEB_ORIGIN=https://ratecoaster.net

# Which origins may call the API from a browser. Same-origin here because Caddy
# serves the API under /api on the same domain, so this is belt and braces.
CORS_ORIGINS=https://ratecoaster.net,https://www.ratecoaster.net

# ─── Email (sign-in links) ───────────────────────────────────────────────────
# Free accounts don't work without this — see Part 11 of DEPLOYING.md.
# Get a key at resend.com, then verify your domain there.
RESEND_API_KEY=CHANGE_ME_RESEND_KEY
EMAIL_FROM="RateCoaster <hello@ratecoaster.net>"

# ─── Collectors ──────────────────────────────────────────────────────────────
# Requests per minute, per website we collect from. Low and polite on purpose.
COLLECTOR_MAX_RPM=12

# Say who you are and how to reach you. If your collector ever causes a problem,
# this is how the site owner contacts you instead of silently blocking you.
COLLECTOR_USER_AGENT="RateCoasterBot/1.0 (+https://ratecoaster.net/bot; you@ratecoaster.net)"

# 1 = log what WOULD be requested without sending anything.
# Leave this at 1 until you have captured a booking endpoint and checked the
# parsed output. Then set it to 0.
COLLECTOR_DRY_RUN=1

# Required for Universal Kids Resort Hotel (UNI012). The booking app publishes
# this guest-client key in its runtime configuration; keep the deploy value out
# of git so it can be rotated without a code change.
UNIVERSAL_KIDS_COMMERCE_CLIENT_ID=mobile_android
UNIVERSAL_KIDS_COMMERCE_CLIENT_SECRET=CHANGE_ME_FROM_PUBLIC_BOOKING_APP

# Which wait-time provider to try first: themeparks or queue-times.
WAITS_PROVIDER=themeparks

# ─── Flights (trip planner) ──────────────────────────────────────────────────
# Sign up free at travelpayouts.com, join the Aviasales programme, then copy
# your API token here. See FLIGHTS.md. Without it the flight collector reports
# "not configured" and the planner prices hotels and tickets only.
#
# There is no per-call cost — you earn commission on bookings instead — so this
# is the one collector that costs nothing to run at full volume.
TRAVELPAYOUTS_TOKEN=CHANGE_ME_TRAVELPAYOUTS_TOKEN

# Your affiliate marker, from the same dashboard. Separate from the token: the
# token reads prices, the marker attributes the click. Without it, outbound
# booking links are hidden entirely rather than sent away unattributed.
TRAVELPAYOUTS_MARKER=CHANGE_ME_TRAVELPAYOUTS_MARKER

# Trip lengths to precompute, in nights. Each one multiplies the size of the
# job, so keep the list short: a long weekend, a short week, a full week.
FLIGHT_TRIP_LENGTHS=3,4,5,6,7

# How many months ahead to fill. 12 covers the full 365-day catalogue.
FLIGHT_MONTHS_AHEAD=12

# How long to keep raw wait samples before folding them into hourly averages.
WAIT_RAW_RETENTION_DAYS=45

# ─── NEVER set this in production ────────────────────────────────────────────
# DEMO_MODE=1 serves INVENTED hotel prices. On a public site that is not a demo,
# it is misinformation about a real purchase. Leave it unset.
# DEMO_MODE=

# ─── Optional: Google sign-in ────────────────────────────────────────────────
# Register this exact authorized redirect URI in Google Cloud:
# https://ratecoaster.net/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Social publishing (optional) ───────────────────────────────────────────
# Leave blank until the platform account and official app are ready. The admin
# Social publishing page remains disabled/dry-run by default even when these
# values exist. X needs no credentials because its posts require human approval.

# Meta Threads: authorize the RateCoaster Threads account with threads_basic
# and threads_content_publish, then exchange for a long-lived user token.
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
# Informational only; shown in admin so a 60-day token does not expire silently.
THREADS_TOKEN_EXPIRES_AT=

# Bluesky: create a dedicated app password in the RateCoaster account settings.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
BLUESKY_PDS_URL=https://bsky.social
