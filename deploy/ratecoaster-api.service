# RateCoaster API service
# Copy to /etc/systemd/system/ratecoaster-api.service

[Unit]
Description=RateCoaster API
# Wait for both the network and Postgres, otherwise the first start races the
# database and fails before Postgres is accepting connections.
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=ratecoaster
WorkingDirectory=/home/ratecoaster/app/apps/api
EnvironmentFile=/home/ratecoaster/app/.env
ExecStart=/usr/bin/npm run start

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ratecoaster-api

# --- Hardening ---
# If the app is ever compromised, these limit what the attacker can reach.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ratecoaster/app
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
