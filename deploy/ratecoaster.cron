# RateCoaster scheduled jobs
# Install with:  sudo crontab -u ratecoaster /home/ratecoaster/app/deploy/ratecoaster.cron
#
# Cron runs with almost no environment, so every line loads .env first and uses
# absolute paths. Every job is wrapped in `flock -n` so a slow upstream response
# never causes overlapping runs to pile up and exhaust the Postgres pool, and
# runs the compiled production bundle (`dist/jobs/*.js`) for instant startup.

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

# Live wait times — every 5 minutes. Works immediately, no setup needed.
*/5 * * * * cd /home/ratecoaster/app && set -a && . ./.env && set +a && mkdir -p /home/ratecoaster/locks && /usr/bin/flock -n /home/ratecoaster/locks/wait-times.lock /usr/bin/npm run collect:prod -- --only wait-times >> /home/ratecoaster/logs/waits.log 2>&1

# Park hours — twice a day. Published weeks ahead and rarely revised.
8 3,15 * * * cd /home/ratecoaster/app && set -a && . ./.env && set +a && mkdir -p /home/ratecoaster/locks && /usr/bin/flock -n /home/ratecoaster/locks/park-hours.lock /usr/bin/npm run collect:prod -- --only park-hours >> /home/ratecoaster/logs/hours.log 2>&1

# Official Universal attraction classifications, imagery and map coordinates — daily.
24 2 * * * cd /home/ratecoaster/app && set -a && . ./.env && set +a && mkdir -p /home/ratecoaster/locks && /usr/bin/flock -n /home/ratecoaster/locks/attraction-metadata.lock /usr/bin/npm run collect:prod -- --only attraction-metadata >> /home/ratecoaster/logs/attraction-metadata.log 2>&1

# Hotel rates — every 6 hours, offset off the hour to avoid stampeding.
17 */6 * * * cd /home/ratecoaster/app && set -a && . ./.env && set +a && mkdir -p /home/ratecoaster/locks && /usr/bin/flock -n /home/ratecoaster/locks/hotel-rates.lock /usr/bin/npm run collect:prod -- --only hotel-rates >> /home/ratecoaster/logs/hotels.log 2>&1

# Ticket prices — twice a day.
23 4,16 * * * cd /home/ratecoaster/app && set -a && . ./.env && set +a && mkdir -p /home/ratecoaster/locks && /usr/bin/flock -n /home/ratecoaster/locks/ticket-prices.lock /usr/bin/npm run collect:prod -- --only ticket-prices >> /home/ratecoaster/logs/tickets.log 2>&1

# Express Pass — every 4 hours; it moves faster than anything else.
41 */4 * * * cd /home/ratecoaster/app && set -a && . ./.env && set +a && mkdir -p /home/ratecoaster/locks && /usr/bin/flock -n /home/ratecoaster/locks/express-pass.lock /usr/bin/npm run collect:prod -- --only express-pass >> /home/ratecoaster/logs/express.log 2>&1

# Flight fares — once a day, in the small hours.
52 2 * * * cd /home/ratecoaster/app && set -a && . ./.env && set +a && mkdir -p /home/ratecoaster/locks && /usr/bin/flock -n /home/ratecoaster/locks/flight-prices.lock /usr/bin/npm run collect:prod -- --only flight-prices >> /home/ratecoaster/logs/flights.log 2>&1

# Rate-drop alerts — 20 minutes after the hotel collector, four times a day.
37 */6 * * * cd /home/ratecoaster/app && set -a && . ./.env && set +a && mkdir -p /home/ratecoaster/locks && /usr/bin/flock -n /home/ratecoaster/locks/alerts.lock /usr/bin/npm run -w @ratecoaster/api alerts:dispatch:prod -- --send >> /home/ratecoaster/logs/alerts.log 2>&1

# Social publishing — eight minutes past every hour, after a fresh wait-time sample.
8 * * * * cd /home/ratecoaster/app && set -a && . ./.env && set +a && mkdir -p /home/ratecoaster/locks && /usr/bin/flock -n /home/ratecoaster/locks/social.lock /usr/bin/npm run -w @ratecoaster/api social:publish:prod -- --send >> /home/ratecoaster/logs/social.log 2>&1

# Nightly: fold wait samples into hourly averages and prune raw rows, sessions, tokens and old runs.
30 3 * * * cd /home/ratecoaster/app && set -a && . ./.env && set +a && mkdir -p /home/ratecoaster/locks && /usr/bin/flock -n /home/ratecoaster/locks/rollup.lock /usr/bin/npm run -w @ratecoaster/api rollup:prod >> /home/ratecoaster/logs/rollup.log 2>&1

# Hourly: preserve dated crowd estimates and flag missing/stale signals in admin.
54 * * * * cd /home/ratecoaster/app && set -a && . ./.env && set +a && mkdir -p /home/ratecoaster/locks && /usr/bin/flock -n /home/ratecoaster/locks/crowd-archive.lock /usr/bin/npm run -w @ratecoaster/api crowds:archive:prod >> /home/ratecoaster/logs/crowd-archive.log 2>&1
