{
  "name": "@ratecoaster/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "collect": "tsx src/jobs/run.ts",
    "har:import": "tsx src/collectors/hotels/har-import.ts",
    "verify:endpoint": "tsx src/jobs/verify-endpoint.ts",
    "rollup": "tsx src/jobs/rollup.ts",
    "test": "node --import tsx --test src/collectors/collectors.test.ts src/collectors/waits/providers.test.ts src/collectors/parks/hours.test.ts src/lib/google-oauth.test.ts src/collectors/flights/flights.test.ts src/routes/trips.test.ts src/lib/trip-cost.test.ts src/lib/alerts.test.ts src/social/content.test.ts src/claims.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit",
    "smoke:waits": "tsx src/jobs/smoke-waits.ts",
    "admin:grant": "tsx src/jobs/grant-admin.ts",
    "login:link": "tsx src/jobs/login-link.ts",
    "flights:probe": "tsx src/jobs/probe-flights.ts",
    "affiliate:seed": "tsx src/jobs/seed-affiliate-links.ts",
    "alerts:dispatch": "tsx src/jobs/dispatch-alerts.ts",
    "social:publish": "tsx src/jobs/publish-social.ts"
  },
  "dependencies": {
    "@ratecoaster/db": "*",
    "@ratecoaster/shared": "*",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "drizzle-orm": "^0.38.3",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2"
  }
}
