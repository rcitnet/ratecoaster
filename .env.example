# --- Database ---
DATABASE_URL=postgres://parkpulse:parkpulse@localhost:5432/parkpulse

# --- API ---
API_PORT=8787
API_BASE_URL=http://localhost:8787
# Comma-separated origins allowed to call the API (web + mobile dev servers)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Collector politeness ---
# Global ceiling on outbound requests per minute, across all collectors.
COLLECTOR_MAX_RPM=30
# Identify yourself honestly. Include a contact address so the operator can
# reach you instead of silently blocking you.
COLLECTOR_USER_AGENT=ParkPulseBot/0.1 (+https://example.com/bot; contact@example.com)
# Set to 1 to log requests without sending them. Use this first.
COLLECTOR_DRY_RUN=1

# --- Wait times (free public APIs, no key required) ---
# Queue-Times requires visible "Powered by Queue-Times.com" attribution.
WAITS_PROVIDER=themeparks

# --- Push notifications (optional, for the mobile companion app) ---
EXPO_ACCESS_TOKEN=
