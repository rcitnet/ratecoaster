# --- Runtime ---
NODE_ENV=development
SITE_NAME=RateCoaster

# --- Database ---
DATABASE_URL=postgres://ratecoaster:ratecoaster@localhost:5432/ratecoaster
DB_POOL_MAX=10

# --- Addresses ---
API_PORT=8787
# Server-to-server address used by the Next.js process.
API_BASE_URL=http://localhost:8787
# Public address used inside email sign-in links and OAuth callbacks.
PUBLIC_API_URL=http://localhost:8787
# Browser-visible API address; changing it requires rebuilding the web app.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
# Website origin used for post-auth redirects and first-party email links.
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated origins allowed to call the API (web + mobile dev servers)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Email sign-in and price alerts (optional) ---
# Get a key from Resend and verify the EMAIL_FROM domain before enabling.
RESEND_API_KEY=
EMAIL_FROM="RateCoaster <thrills@ratecoaster.net>"

# --- Google sign-in (optional) ---
# Production redirect URI: https://ratecoaster.net/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Advertising (optional; leave slots blank until AdSense approves the site) ---
# The public account id and ads.txt record are built in. Each slot id is created
# inside the AdSense dashboard. Auto ads and Google's CMP do not need slot ids.
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_HOTELS=
NEXT_PUBLIC_ADSENSE_SLOT_HOTEL_DETAIL=
NEXT_PUBLIC_ADSENSE_SLOT_TICKETS=
NEXT_PUBLIC_ADSENSE_SLOT_EXPRESS=
NEXT_PUBLIC_ADSENSE_SLOT_WAITS=
NEXT_PUBLIC_ADSENSE_SLOT_PLANNER=
NEXT_PUBLIC_ADSENSE_SLOT_GUIDES=

# --- Collector politeness ---
# Global ceiling on outbound requests per minute, across all collectors.
COLLECTOR_MAX_RPM=30
# Identify yourself honestly. Include a contact address so the operator can
# reach you instead of silently blocking you.
COLLECTOR_USER_AGENT="RateCoasterBot/1.0 (+https://ratecoaster.net/bot; thrills@ratecoaster.net)"
# Set to 1 to log requests without sending them. Use this first.
COLLECTOR_DRY_RUN=1

# Universal Kids Resort's public guest commerce client. The client id defaults
# to mobile_android; copy the current client key from the public booking app's
# runtime configuration into the secret value on each deployment.
UNIVERSAL_KIDS_COMMERCE_CLIENT_ID=mobile_android
UNIVERSAL_KIDS_COMMERCE_CLIENT_SECRET=
UNIVERSAL_ORLANDO_COMMERCE_CLIENT_ID=mobile_android
UNIVERSAL_ORLANDO_COMMERCE_CLIENT_SECRET=

# --- Flights (Aviasales via Travelpayouts) ---
# Keep the API token server-side. The partner ID is used only for attributed
# outbound search links. See FLIGHTS.md before enabling the collector.
AVIASALES_API_TOKEN=
TRAVELPAYOUTS_PARTNER_ID=
FLIGHT_TRIP_LENGTHS=3,4,5,6,7
FLIGHT_MONTHS_AHEAD=12
# Planner estimates may use observations this recent even after the upstream
# cache's much shorter booking-validity timestamp expires.
FLIGHT_PLANNER_MAX_AGE_HOURS=36
FLIGHT_PLANNER_NEARBY_DAYS=45

# --- Wait times (free public APIs, no key required) ---
# Queue-Times requires visible "Powered by Queue-Times.com" attribution.
WAITS_PROVIDER=themeparks

# --- Push notifications (optional, for the mobile companion app) ---
EXPO_ACCESS_TOKEN=

# --- Analytics (both optional and independent) ---
# Read at runtime by the web layout, so changing either needs only a service
# restart, not a rebuild. Deliberately NOT NEXT_PUBLIC_*: those are inlined at
# build time, so a value added here without rebuilding would silently never
# appear on the page. See ANALYTICS.md.
#
# A value left blank, or left looking like a placeholder, means the tag is not
# emitted at all. That is on purpose — a tag that loads with a broken id records
# nothing and reports it as "no traffic".
#
# Cloudflare Web Analytics: 32 hex characters, cookieless, no consent banner.
CLOUDFLARE_ANALYTICS_TOKEN=
# Google Analytics 4: G- followed by the stream id. Sets cookies.
GA_MEASUREMENT_ID=
