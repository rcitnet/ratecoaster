# --- Database ---
DATABASE_URL=postgres://ratecoaster:ratecoaster@localhost:5432/ratecoaster

# --- API ---
API_PORT=8787
API_BASE_URL=http://localhost:8787
# Comma-separated origins allowed to call the API (web + mobile dev servers)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Google sign-in (optional) ---
# Production redirect URI: https://ratecoaster.net/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Collector politeness ---
# Global ceiling on outbound requests per minute, across all collectors.
COLLECTOR_MAX_RPM=30
# Identify yourself honestly. Include a contact address so the operator can
# reach you instead of silently blocking you.
COLLECTOR_USER_AGENT="RateCoasterBot/0.1 (+https://ratecoaster.net/bot; contact@ratecoaster.net)"
# Set to 1 to log requests without sending them. Use this first.
COLLECTOR_DRY_RUN=1

# Universal Kids Resort's public guest commerce client. The client id defaults
# to mobile_android; copy the current client key from the public booking app's
# runtime configuration into the secret value on each deployment.
UNIVERSAL_KIDS_COMMERCE_CLIENT_ID=mobile_android
UNIVERSAL_KIDS_COMMERCE_CLIENT_SECRET=
UNIVERSAL_ORLANDO_COMMERCE_CLIENT_ID=mobile_android
UNIVERSAL_ORLANDO_COMMERCE_CLIENT_SECRET=

# --- Wait times (free public APIs, no key required) ---
# Queue-Times requires visible "Powered by Queue-Times.com" attribution.
WAITS_PROVIDER=themeparks

# --- Push notifications (optional, for the mobile companion app) ---
EXPO_ACCESS_TOKEN=
